# ---- اجباری ---------------------------------------------------------------
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
SESSION=

# ---- پنل کنترل شیشه‌ای ----------------------------------------------------
# دکمه‌های شیشه‌ای (inline) فقط از سمت ربات ساخته می‌شوند، نه از اکانت.
# یک ربات از @BotFather بساز و توکنش را اینجا بگذار تا پنل فعال شود.
# خالی بگذار ⇒ همه چیز کار می‌کند، فقط پنل نیست.
BOT_TOKEN=
# مالک پنل. خالی = همان اکانتی که با آن لاگین کرده‌ای (توصیه‌شده).
PANEL_OWNER=

# ---- اختیاری --------------------------------------------------------------
# مقصد آرشیو: me = Saved Messages، یا یوزرنیم کانال شخصی مثل @myarchive
STORAGE_PEER=me
PORT=3000
DATA_DIR=./data
DEVICE_MODEL=Elegram Desktop

# ---- کامنت اول روی پست‌های کانال ------------------------------------------
# کانال و متن را با دستور `.comment @channel | متن` تنظیم می‌کنی؛ اینها فقط
# رفتار زمان‌بندی‌اش را عوض می‌کنند. پیش‌فرض‌ها روی «سریع‌ترین حالت» تنظیم‌اند.
# چند میلی‌ثانیه بعد از انتشار پست کامنت گذاشته شود (0 = بلافاصله)
FIRST_COMMENT_DELAY_MS=0
# تلگرام پست را با کمی تأخیر در گروه گفتگو کپی می‌کند؛ چند بار دنبالش بگردد؟
FIRST_COMMENT_ATTEMPTS=12
# فاصله‌ی اولین جست‌وجوها (ms). هر بار ۱.۴ برابر قبلی می‌شود. کمش کن = سریع‌تر
FIRST_COMMENT_POLL_MS=150
# سقف کل زمانی که برای پیدا کردن کپی پست صبر می‌کند (ms)
FIRST_COMMENT_TIMEOUT_MS=10000
# حداقل فاصله بین دو کامنت (ms). کمتر = سریع‌تر، ولی خطر FLOOD_WAIT بیشتر
FIRST_COMMENT_SEND_GAP_MS=400
# اگر عضو گروه گفتگو نیستی خودش عضو شود (بدون این، کامنت گذاشتن ممکن نیست)
FIRST_COMMENT_JOIN=true
# گروه گفتگوی کانال‌ها را همان اول (نه وسط مسابقه) پیدا و عضو شود
FIRST_COMMENT_WARM=true

# ---- تنظیمات پیشرفته ------------------------------------------------------
# چند فایل هم‌زمان آرشیو شود (1..8) — از داخل پنل هم قابل تغییر است
CONCURRENCY=2
# چند میلی‌ثانیه صبر کند تا کل آلبوم برسد (200..15000)
ALBUM_WINDOW_MS=1200
# موازی‌سازی آپلود/دانلود هر فایل (1..16)
UPLOAD_WORKERS=4
MAX_CONCURRENT_DOWNLOADS=4
# FLOOD_WAIT کوتاه‌تر از این مقدار (ثانیه) خودکار تحمل می‌شود
FLOOD_SLEEP_THRESHOLD=60
# ری‌اکشن روی پیام اصلی بعد از .save — خالی بگذار تا غیرفعال شود
DONE_REACTION=👍
# بازیابی پیام‌های ازدست‌رفته پس از ری‌استارت
CATCH_UP=true
TIMEZONE=Asia/Tehran
# silent | error | warn | info | debug
LOG_LEVEL=info
